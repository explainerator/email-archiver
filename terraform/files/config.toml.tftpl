# email-archiver configuration — GENERATED BY TERRAFORM. DO NOT EDIT BY HAND.
#
# Rendered from terraform/files/config.toml.tftpl and written to the instance
# by the deploy step, mode 0600. Regenerate with `terraform apply`; edits made
# here are lost on the next deploy.
#
# Contains live S3 secret keys.

# Encrypts source mailbox passwords, which live in the database. Deliberately
# kept here and not there: a key stored alongside what it protects is
# decoration. Losing it makes every stored source password unreadable.
encryption_key = "${encryption_key}"

[database]
max_connections = ${database_max_connections}
# The binary asserts current_database() = "archive" before doing anything, so a
# wrong value here fails loudly rather than touching the game services' data.
url = "${database_url}"

[ingest]
# Messages processed in parallel within one fetched batch. The work is
# latency-bound (S3 and Postgres round trips), not CPU-bound, so this can
# exceed the core count. Keep database.max_connections at least this high.
concurrency = ${ingest_concurrency}

[s3]
endpoint = "${s3_endpoint}"
region   = "${s3_region}"

# ----------------------------------------------------------------------------
# Per-bucket credentials.
#
# Keyed by BUCKET, not by user: Postgres is authoritative for which users exist
# and which bucket each one owns (users.bucket). This file only answers "how do
# I reach that bucket". A bucket present in the database but missing here is a
# startup error, not a silent failure at read time.
#
# Each credential is scoped by policy to exactly one bucket, so the archiver
# never holds a key that can read another person's mail.
# ----------------------------------------------------------------------------
%{ for bucket, creds in buckets ~}
[s3.credentials."${bucket}"]
access_key = "${creds.access_key}"
secret_key = "${creds.secret_key}"

%{ endfor ~}

# ----------------------------------------------------------------------------
# TLS for the IMAP listener.
#
# Certificates come from files rather than an in-process ACME client, so
# certbot (or anything else) handles issuance and renewal on its own schedule
# and this program only reads them. They are re-read when they change, so a
# renewal is picked up without a restart.
#
# Leave unset to serve plaintext — which the server will only allow on
# loopback, because IMAP LOGIN sends the password in the clear.
# ----------------------------------------------------------------------------
%{ if tls_cert_path != "" ~}
[tls]
cert_path = "${tls_cert_path}"
key_path  = "${tls_key_path}"
%{ endif ~}

# ----------------------------------------------------------------------------
# Google Workspace ingest.
#
# One service account with domain-wide delegation serves every mailbox in the
# domain, so there is nothing per-account to configure and no refresh token to
# store or expire. Absent unless there are Workspace mailboxes to ingest.
# ----------------------------------------------------------------------------
%{ if gmail_service_account_key != "" ~}
[gmail]
service_account_key = "${gmail_service_account_key}"
%{ endif ~}
